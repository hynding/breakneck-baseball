{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "Provisioning cloud container"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; case \"$f\" in *.rs) PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" rustfmt --edition 2024 \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting Rust file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-clippy.sh",
            "timeout": 180,
            "statusMessage": "Running cargo clippy"
          }
        ]
      }
    ]
  }
}
